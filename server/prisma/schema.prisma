
generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Document {
  id        String       @id @default(cuid())
  title     String
  createdAt DateTime     @default(now())
  versions  DocVersion[]
}

model DocVersion {
  id             String   @id @default(cuid())
  documentId     String
  document       Document @relation(fields: [documentId], references: [id])
  versionNumber  Int
  status         String   @default("processing") // "processing" | "ready" | "failed"
  sourceVideoUrl String?
  errorMessage   String?
  contentJson    Json?
  createdAt      DateTime @default(now())
  steps          Step[]

  diffsAsOld Diff[] @relation("DiffOldVersion")
  diffsAsNew Diff[] @relation("DiffNewVersion")

  @@unique([documentId, versionNumber])
}

model Step {
  id            String     @id @default(cuid())
  docVersionId  String
  docVersion    DocVersion @relation(fields: [docVersionId], references: [id])
  orderIndex    Int
  title         String
  bodyText      String
  screenshotUrl String
  embedding     Json?      // array of floats, stored as JSON for SQLite
}

model Diff {
  id           String     @id @default(cuid())
  oldVersionId String
  oldVersion   DocVersion @relation("DiffOldVersion", fields: [oldVersionId], references: [id])
  newVersionId String
  newVersion   DocVersion @relation("DiffNewVersion", fields: [newVersionId], references: [id])
  stepDiffs    Json
  createdAt    DateTime   @default(now())

  @@unique([oldVersionId, newVersionId])
}

model OtpCode {
  id        String   @id @default(cuid())
  email     String
  code      String
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([email])
}